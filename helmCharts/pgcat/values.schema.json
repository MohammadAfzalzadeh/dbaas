{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "existingSecret": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)?$"
    },
    "pgadmin": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)?$"
        }
      }
    },
    "pgcatconfig": {
      "type": "object",
      "properties": {
        "general": {
          "type": "object",
          "properties": {
            "PGCAT_PORT": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
                }
              ]
            },
            "PROMETHEUS_EXPORTER_PORT": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ENABLE_PROMETHEUS": {
              "type": "boolean"
            }
          },
          "required": [
            "PGCAT_PORT",
            "PROMETHEUS_EXPORTER_PORT"
          ]
        }
      },
      "required": [
        "general"
      ]
    }
  },
  "required": [
    "replicaCount",
    "pgcatconfig",
    "pgadmin"
  ]
}
