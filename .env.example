# Generate a unique random token of at least 32 characters out of band.
# Empty token keeps /api/* disabled (503). Never commit the populated .env.
DBAAS_API_TOKEN=
DBAAS_ALLOWED_NAMESPACES=dbaas
# Same-origin browser requests by default; comma-separated exact origins if needed.
DBAAS_ALLOWED_ORIGINS=
DBAAS_ALLOW_INLINE_SECRETS=false
LOG_LEVEL=INFO
