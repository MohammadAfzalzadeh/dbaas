{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "minio": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "const": 1
        },
        "adminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "consolePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)?$"
        }
      },
      "required": [
        "replicaCount",
        "adminPort",
        "consolePort"
      ]
    }
  },
  "required": [
    "minio"
  ]
}
