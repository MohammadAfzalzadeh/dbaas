security:
  allowInlineSecrets: {{ inlineSecrets | lower }}
{% if inlineSecrets %}
# The API supplies the exact Helm release used by the Patroni chart.
patroniReleaseName: "{{ patroniReleaseName }}"
replicaCount: 1
imagePullPolicy: IfNotPresent
# Image selection comes from the operator's chart defaults.

pgadmin:
  email: "admin@example.com"
  pass: {{ postgresql.superuser.password | tojson }}

# Construct pgcat.yaml from your form data
pgcatconfig:
  general:
    PGCAT_PORT: "5432"
    PGCAT_SUPERUSER_USERNAME: {{ postgresql.superuser.username | tojson }}
    PGCAT_SUPERUSER_PASSWORD: {{ postgresql.superuser.password | tojson }}
    ENABLE_PROMETHEUS: true

  DBS:
  {% for db in databases %}
    - NAME: {{ db.name | tojson }}
      POOL_MODE: "{{ db.poolMode or "session" }}"
      PRIMARY_READ: {{ (postgresql.pgReplicas == 1 or db.primaryReadMode or false) | lower }}
      SHARDING_FUNCTION: "pg_bigint_hash"
      users:
        {% for u in users %}
        - USER_NAME: {{ u.username | tojson }}
          PASSWORD: {{ u.password | tojson }}
          POOL_SIZE: {{ (u.connectionLimit or 10) | int }}
          STATEMENT_TIMEOUT: 0
        {% endfor %}
      shards:
        - MASTER_HOST:  "patronimvp-master-{{ patroniReleaseName }}"
          MASTER_PORT:  "5432"
          REPLICA_HOST: {{ (("patronimvp-replica-" ~ patroniReleaseName) if postgresql.pgReplicas > 1 else "") | tojson }}
          INCLUDE_REPLICA: {{ (postgresql.pgReplicas > 1) | lower }}
          REPLICA_PORT: "5432"
  {% endfor %}

{% else %}
patroniReleaseName: {{ patroniReleaseName | tojson }}
existingSecret: {{ existingSecrets.pgcat | tojson }}
pgadmin:
  existingSecret: {{ existingSecrets.pgadmin | tojson }}
{% endif %}
